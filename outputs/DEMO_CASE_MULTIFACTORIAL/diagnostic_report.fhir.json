    {
      "fullUrl": "urn:uuid:22e867c4-303e-4ccc-acf9-b97da84495d9",
      "resource": {
        "resourceType": "ServiceRequest",
        "id": "svcreq-0",
        "status": "draft",
        "intent": "proposal",
        "priority": "routine",
        "code": {
          "coding": [
            {
              "display": "Plasma metanephrines and normetanephrines"
            }
          ],
          "text": "Plasma metanephrines and normetanephrines"
        },
        "subject": {
          "reference": "urn:uuid:b9da37d1-9add-4a0c-9b50-734faf400255"
        },
        "reasonCode": [
          {
            "text": "The patient has symptoms potentially consistent with pheochromocytoma/paraganglioma (tumour, racing heart, fainting, weight loss, tingling). Measuring plasma metanephrines and normetanephrines is the standard biochemical test to screen for these catecholamine-secreting tumors."
          }
        ],
        "note": [
          {
            "text": "Power: exclusionary. A positive result would establish: Pheochromocytoma/paraganglioma if elevated. A negative result would rule out: Pheochromocytoma/paraganglioma if normal (though sensitivity is not 100%)."
          }
        ]
      }
    },
    {
      "fullUrl": "urn:uuid:49a4c5fd-439a-4670-abb4-f16104269b09",
      "resource": {
        "resourceType": "ServiceRequest",
        "id": "svcreq-1",
        "status": "draft",
        "intent": "proposal",
        "priority": "routine",
        "code": {
          "coding": [
            {
              "display": "HbA1c"
            }
          ],
          "text": "HbA1c"
        },
        "subject": {
          "reference": "urn:uuid:b9da37d1-9add-4a0c-9b50-734faf400255"
        },
        "reasonCode": [
          {
            "text": "The patient has symptoms (polydipsia, weight loss) and biochemistry (increased blood glucose) suggestive of diabetes mellitus. HbA1c provides a measure of average blood glucose control over the preceding 2-3 months and helps confirm the diagnosis of diabetes."
          }
        ],
        "note": [
          {
            "text": "Power: exclusionary. A positive result would establish: Diabetes mellitus if elevated. A negative result would rule out: Diabetes mellitus if normal (though less sensitive for recent onset)."
          }
        ]
      }
    },
    {
      "fullUrl": "urn:uuid:7c618be7-53c8-4a3a-902d-233742aba33a",
      "resource": {
        "resourceType": "ServiceRequest",
        "id": "svcreq-2",
        "status": "draft",
        "intent": "proposal",
        "priority": "routine",
        "code": {
          "coding": [
            {
              "display": "Autoantibody panel for Type 1 Diabetes Mellitus (e.g., GAD65, IA-2, insulin autoantibodies)"
            }
          ],
          "text": "Autoantibody panel for Type 1 Diabetes Mellitus (e.g., GAD65, IA-2, insulin autoantibodies)"
        },
        "subject": {
          "reference": "urn:uuid:b9da37d1-9add-4a0c-9b50-734faf400255"
        },
        "reasonCode": [
          {
            "text": "The patient presents with symptoms suggestive of diabetes mellitus (polydipsia, weight loss, increased blood glucose) at age 49. While Type 2 Diabetes is more common at this age, the presentation could potentially be Latent Autoimmune Diabetes in Adults (LADA), a form of Type 1 diabetes that develops more slowly in adults. Testing for autoantibodies specific to pancreatic beta cells can help differentiate between Type 1/LADA and Type 2 diabetes."
          }
        ],
        "note": [
          {
            "text": "Power: supportive. A positive result would establish: Type 1 Diabetes Mellitus or LADA if positive. A negative result would rule out: Type 1 Diabetes Mellitus or LADA if negative (though some patients may be antibody negative)."
          }
        ]
      }
    },
    {
      "fullUrl": "urn:uuid:da01fc2f-def6-4d34-976f-a1f4166bc49d",
      "resource": {
        "resourceType": "ServiceRequest",
        "id": "svcreq-3",
        "status": "draft",
        "intent": "proposal",
        "priority": "routine",
        "code": {
          "coding": [
            {
              "display": "Thyroid peroxidase antibodies (TPOAb)"
            }
          ],
          "text": "Thyroid peroxidase antibodies (TPOAb)"
        },
        "subject": {
          "reference": "urn:uuid:b9da37d1-9add-4a0c-9b50-734faf400255"
        },
        "reasonCode": [
          {
            "text": "The patient has high TSH and low free T4, indicating hypothyroidism. Autoimmune thyroid disease (Hashimoto's thyroiditis) is the most common cause of hypothyroidism in iodine-sufficient areas. Testing for TPOAb can confirm an autoimmune etiology."
          }
        ],
        "note": [
          {
            "text": "Power: exclusionary. A positive result would establish: Autoimmune hypothyroidism if positive. A negative result would rule out: Autoimmune hypothyroidism if negative (though sensitivity is not 100%)."
          }
        ]
      }
    },
