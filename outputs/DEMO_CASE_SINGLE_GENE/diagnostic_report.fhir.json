    {
      "fullUrl": "urn:uuid:2d4f6fdd-66ca-473d-ba60-616f571f72f7",
      "resource": {
        "resourceType": "ServiceRequest",
        "id": "svcreq-0",
        "status": "draft",
        "intent": "proposal",
        "priority": "urgent",
        "code": {
          "coding": [
            {
              "display": "Enzyme activity assay for alpha-galactosidase A (GLA)"
            }
          ],
          "text": "Enzyme activity assay for alpha-galactosidase A (GLA)"
        },
        "subject": {
          "reference": "urn:uuid:973a1130-110b-4d33-b3c6-6935c63fc288"
        },
        "reasonCode": [
          {
            "text": "The patient's phenotype (renal failure, proteinuria, hypertrophic cardiomyopathy, burning limb pain, abdominal pain, intolerance to temperature extremes) and family history are highly suggestive of Fabry disease. The top candidate gene is GLA, which encodes alpha-galactosidase A. Measuring the enzyme activity in leukocytes or plasma can directly assess the function of the GLA gene product."
          }
        ],
        "note": [
          {
            "text": "Power: decisive. A positive result would establish: Fabry disease if enzyme activity is deficient (<20% of normal). A negative result would rule out: Fabry disease if enzyme activity is normal or near normal (>20% of normal)."
          }
        ]
      }
    },
    {
      "fullUrl": "urn:uuid:82096e84-87a5-4f2f-9380-49572e571485",
      "resource": {
        "resourceType": "ServiceRequest",
        "id": "svcreq-1",
        "status": "draft",
        "intent": "proposal",
        "priority": "urgent",
        "code": {
          "coding": [
            {
              "display": "Genetic sequencing of the GLA gene"
            }
          ],
          "text": "Genetic sequencing of the GLA gene"
        },
        "subject": {
          "reference": "urn:uuid:973a1130-110b-4d33-b3c6-6935c63fc288"
        },
        "reasonCode": [
          {
            "text": "Given the strong suspicion for Fabry disease based on clinical features and family history, sequencing the GLA gene will identify pathogenic variants responsible for deficient alpha-galactosidase A activity. This test can confirm the diagnosis and identify specific mutations."
          }
        ],
        "note": [
          {
            "text": "Power: decisive. A positive result would establish: Fabry disease if a pathogenic variant in GLA is identified. A negative result would rule out: Fabry disease if no pathogenic variant in GLA is identified (though this would be less likely given the strong clinical picture and family history; a normal enzyme assay would be more definitive for ruling out Fabry)."
          }
        ]
      }
    },
